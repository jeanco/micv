# ==============================================================================
# CONFIGURACIÓN DE URLS LIMPIAS (SIN EXTENSIÓN .HTML)
# Compatible con Apache, LiteSpeed, Laragon y servidores de hosting (cPanel)
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Definir documento por defecto
  DirectoryIndex index.html index.php

  # 2. Redireccionar permanentemente peticiones con .html a su versión limpia
  # Ejemplo: http://micv.creala.online/admin.html -> http://micv.creala.online/admin
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.*?)\.html[\s?] [NC]
  RewriteRule ^ %1 [R=301,L]

  # 3. Si la petición coincide con una carpeta real (como /admin/), servir su index.html
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. Si la petición no es un directorio ni archivo y existe con .html, servirlo internamente
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# Seguridad y compresión básica
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>
